# Normalización de saltos de línea: el repositorio SIEMPRE almacena LF.
# El working tree puede tener CRLF (Windows), git lo convierte transparentemente.
* text=auto

# Código fuente y configuraciones: LF explícito en el repositorio
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.example text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
