---
import Base from "@/layouts/Base.astro";
import LandingShell from "@/components/landing/LandingShell.tsx";
import Hero from "@/components/landing/Hero.tsx";
import FeaturedCourses from "@/components/landing/FeaturedCourses.astro";
import TechMarquee from "@/components/landing/TechMarquee.tsx";
import LearnSections from "@/components/landing/LearnSections.tsx";
import LandingFooter from "@/components/landing/LandingFooter.tsx";
---

<Base
  title="Developer Mastery Hub — Domina cualquier stack"
  bodyClass="is-landing"
>
  <LandingShell client:load />
  <main>
    <Hero client:load />
    <FeaturedCourses />
    <TechMarquee />
    <LearnSections client:visible />

    <section class="mx-auto max-w-[1280px] px-4 pb-24 pt-4 sm:px-6 sm:pb-28">
      <div
        class="relative overflow-hidden rounded-[34px] border border-brand/30 bg-brand px-6 py-14 text-canvas sm:px-12 sm:py-16"
      >
        <div
          class="pointer-events-none absolute -right-16 -top-20 h-72 w-72 rounded-full border-[48px] border-canvas/10"
          aria-hidden="true"
        >
        </div>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="font-mono text-sm font-bold uppercase tracking-[0.16em]">
              {"{ Tu siguiente habilidad empieza aquí }"}
            </p>
            <h2
              class="mt-4 max-w-4xl text-[clamp(2.5rem,6vw,5rem)] font-semibold leading-[.98] tracking-[-0.05em]"
            >
              Mira el temario. Elige tu ruta. Empieza cuando quieras.
            </h2>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-canvas/75 sm:text-lg">
              No necesitas una cuenta para descubrir los cursos. Explora primero
              y regístrate cuando encuentres el indicado.
            </p>
          </div>
          <a
            href="/cursos"
            class="inline-flex min-h-14 shrink-0 items-center justify-center gap-3 rounded-full bg-canvas px-7 text-base font-bold text-cream transition hover:-translate-y-1 hover:shadow-float"
          >
            Abrir catálogo
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <LandingFooter />
</Base>
